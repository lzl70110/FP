@using FP.Web.Extensions
@using FP.Web.Models

@{
    var result = TempData.GetCrudResult();
}

@if (result != null)
{
    <div class="modal fade"
         id="crudResultModal"
         tabindex="-1"
         aria-labelledby="crudResultModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-lg crud-result-dialog">
            <div class="modal-content">

                <div class="modal-header py-2">

                    <h5 class="modal-title fw-semibold"
                        id="crudResultModalLabel">

                        @switch (result.Type)
                        {
                            case CrudResultType.Success:
                                <svg bootstrap-icon="CheckCircleFill"
                                     width="20"
                                     height="20"
                                     class="text-success me-2"
                                     aria-hidden="true"></svg>
                                break;

                            case CrudResultType.Info:
                                <svg bootstrap-icon="InfoCircleFill"
                                     width="20"
                                     height="20"
                                     class="text-info me-2"
                                     aria-hidden="true"></svg>
                                break;

                            case CrudResultType.Warning:
                                <svg bootstrap-icon="ExclamationTriangleFill"
                                     width="20"
                                     height="20"
                                     class="text-warning me-2"
                                     aria-hidden="true"></svg>
                                break;

                            case CrudResultType.Error:
                                <svg bootstrap-icon="XCircleFill"
                                     width="20"
                                     height="20"
                                     class="text-danger me-2"
                                     aria-hidden="true"></svg>
                                break;

                            default:
                                <svg bootstrap-icon="InfoCircleFill"
                                     width="20"
                                     height="20"
                                     class="text-info me-2"
                                     aria-hidden="true"></svg>
                                break;
                        }

                        @result.Title

                    </h5>

                </div>

                <div class="modal-body py-3 crud-result-body fw-bold">
                    @result.Message
                </div>

            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const modalElement =
                document.getElementById("crudResultModal");

            if (modalElement) {

                const modal =
                    new bootstrap.Modal(modalElement);

                modal.show();

                setTimeout(function () {
                    modal.hide();
                }, 4000);
            }
        });
    </script>
}