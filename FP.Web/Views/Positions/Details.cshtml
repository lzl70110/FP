@model FP.Domain.Entities.Positions.Position

@{
    ViewData["Title"] = "Детайли за длъжността";
    var departmentId = (int)ViewData["DepartmentId"]!;
}

<h1>Детайли за длъжността</h1>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Наименование
            </dt>
            <dd class="col-sm-9">
                @Model.Name
            </dd>

            <dt class="col-sm-3">
                Бележки
            </dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Notes)
                                ? "—"
                                : Model.Notes)
            </dd>

            <dt class="col-sm-3">
                Активна
            </dt>
            <dd class="col-sm-9">
                @(Model.IsActive ? "Да" : "Не")
            </dd>

        </dl>

    </div>
</div>

<div class="mt-3">

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       asp-route-departmentId="@departmentId"
       class="btn btn-warning">
        <i class="bi bi-pencil"></i>
        Редактирай
    </a>

    <a asp-action="Index"
       asp-route-departmentId="@departmentId"
       class="btn btn-secondary">
        Назад
    </a>

</div>