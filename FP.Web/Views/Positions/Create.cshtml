@model FP.Web.Models.Forms.NamedActiveEntityViewModel

@{
    var departmentId = (int)ViewData["DepartmentId"]!;
    var departmentName = ViewData["DepartmentName"]?.ToString();

    ViewData["Title"] = $"Добавяне на длъжност: {departmentName}";
}

<div class="mb-4">
    <h1>@departmentName</h1>
    <h4>Добавяне на длъжност</h4>
</div>

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create"
              asp-route-departmentId="@departmentId"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="Name"
                       class="form-label fw-bold fst-italic">
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Notes"
                       class="form-label fw-bold fst-italic">
                </label>

                <input asp-for="Notes"
                       class="form-control" />

                <span asp-validation-for="Notes"
                      class="text-danger">
                </span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsActive"
                       class="form-check-input" />

                <label asp-for="IsActive"
                       class="form-check-label fw-bold fst-italic">
                </label>
            </div>

            <button type="submit"
                    class="btn btn-primary">

                <svg bootstrap-icon="Check"
                     width="16"
                     height="16"
                     aria-hidden="true"></svg>

                Запази
            </button>

            <a asp-action="Index"
               asp-route-departmentId="@departmentId"
               class="btn btn-secondary">

                <svg bootstrap-icon="X"
                     width="16"
                     height="16"
                     aria-hidden="true"></svg>

                Отказ
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}