 
@model List<FP.Domain.Entities.Employees.Employee>

@{
    ViewData["Title"] = $"Изтрити служители: {ViewData["DepartmentName"]}";
    var departmentId = (int)ViewData["DepartmentId"]!;
    var departmentName = ViewData["DepartmentName"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Изтрити служители</h1>
        <h5 class="text-muted">
            Звено: @departmentName
        </h5>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        В това звено няма изтрити служители.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Работен номер</th>
                    <th>Служител</th>
                    <th>Длъжност</th>
                    <th>Статус</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                        <td>
                            @employee.WorkNumber
                        </td>

                        <td>
                            @employee.FirstName

                            @if (!string.IsNullOrWhiteSpace(employee.MiddleName))
                            {
                                @($" {employee.MiddleName}")
                            }

                            @($" {employee.LastName}")
                        </td>

                        <td>
                            @employee.Position?.Name
                        </td>

                        <td>
                            <span class="badge bg-danger">
                                Изтрит
                            </span>
                        </td>

                        <td class="text-end">
                            <form asp-action="Undelete"
                                  asp-route-id="@employee.Id"
                                  asp-route-departmentId="@departmentId"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-success">

                                    <svg bootstrap-icon="ArrowCounterclockwise"
                                         width="16"
                                         height="16"
                                         aria-hidden="true"></svg>

                                    Възстанови
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-action="Index"
       asp-route-departmentId="@departmentId"
       class="btn btn-outline-secondary">

        <svg bootstrap-icon="ArrowLeft"
             width="16"
             height="16"
             aria-hidden="true"></svg>

        Назад към служителите
    </a>
</div>
 
