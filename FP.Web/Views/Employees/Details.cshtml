 
@model FP.Domain.Entities.Employees.Employee

@{
    ViewData["Title"] = $"Работник: {Model.FirstName} {Model.LastName}";
    var departmentId = (int)ViewData["DepartmentId"]!;
}

<h1>Данни за работника</h1>

<div class="card">
    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.WorkNumber)
            </dt>
            <dd class="col-sm-9">
                @Model.WorkNumber
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.FirstName)
            </dt>
            <dd class="col-sm-9">
                @Model.FirstName
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.MiddleName)
            </dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.MiddleName)
                                ? "—"
                                : Model.MiddleName)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.LastName)
            </dt>
            <dd class="col-sm-9">
                @Model.LastName
            </dd>

            <dt class="col-sm-3">
                Длъжност
            </dt>
            <dd class="col-sm-9">
                @Model.Position?.Name
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Notes)
            </dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Notes)
                                ? "—"
                                : Model.Notes)
            </dd>

            <dt class="col-sm-3">
                Статус
            </dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Активен</span>
                }
                else
                {
                    <span class="badge bg-secondary">Неактивен</span>
                }
            </dd>

        </dl>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       asp-route-departmentId="@departmentId"
       class="btn btn-primary">
        Редакция
    </a>

    <a asp-action="Index"
       asp-route-departmentId="@departmentId"
       class="btn btn-secondary">
        Назад
    </a>
</div>
  
