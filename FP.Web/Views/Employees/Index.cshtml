 
@model List<FP.Domain.Entities.Employees.Employee>

@{
    ViewData["Title"] = $"Служители: {ViewData["DepartmentName"]}";
    var departmentId = (int)ViewData["DepartmentId"]!;
    var departmentName = ViewData["DepartmentName"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Служители</h1>
        <h5 class="text-muted">
            Звено: @departmentName
        </h5>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Deleted"
           asp-route-departmentId="@departmentId"
           class="btn btn-outline-danger">

            <svg bootstrap-icon="Trash"
                 width="16"
                 height="16"
                 aria-hidden="true"></svg>

            Изтрити служители
        </a>

        <a asp-action="Create"
           asp-route-departmentId="@departmentId"
           class="btn btn-primary">

            <svg bootstrap-icon="PersonPlus"
                 width="16"
                 height="16"
                 aria-hidden="true"></svg>

            Добави служител
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        В това звено няма въведени служители.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Работен номер</th>
                    <th>Служител</th>
                    <th>Длъжност</th>
                    <th>Статус</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                        <td>
                            @employee.WorkNumber
                        </td>

                        <td>
                            @employee.FirstName

                            @if (!string.IsNullOrWhiteSpace(employee.MiddleName))
                            {
                                @($" {employee.MiddleName}")
                            }

                            @($" {employee.LastName}")
                        </td>

                        <td>
                            @employee.Position?.Name
                        </td>

                        <td>
                            @if (employee.IsActive)
                            {
                                <span class="badge bg-success">
                                    Активен
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Неактивен
                                </span>
                            }
                        </td>

                        <td class="text-end">
                            <a asp-action="Details"
                               asp-route-id="@employee.Id"
                               asp-route-departmentId="@departmentId"
                               class="btn btn-sm btn-outline-primary">

                                Детайли
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@employee.Id"
                               asp-route-departmentId="@departmentId"
                               class="btn btn-sm btn-outline-secondary">

                                Редакция
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@employee.Id"
                                  asp-route-departmentId="@departmentId"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">

                                    Изтрий
                                </button>

                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-controller="Departments"
       asp-action="Details"
       asp-route-id="@departmentId"
       class="btn btn-outline-secondary">

        <svg bootstrap-icon="ArrowLeft"
             width="16"
             height="16"
             aria-hidden="true"></svg>

        Назад към звеното
    </a>
</div>
 
