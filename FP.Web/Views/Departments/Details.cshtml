@model FP.Domain.Entities.Departments.Department
@using FP.Infrastructure.Services
@inject DateTimeService DateTimeService

@{
    ViewData["Title"] = $"Звено: {Model.Name}";

    var deleteModal = new FP.Web.Models.DeleteConfirmViewModel
    {
        ModalId = "deleteConfirmModal",
        ModalIdLabel = "deleteConfirmModalLabel",
        Message = $"Сигурни ли сте, че искате да изтриете звеното „{Model.Name}“?",
        Controller = "Departments",
        Action = "Delete",
        Id = Model.Id
    };
}

<h1>Звено: @Model.Name</h1>

<div class="row">
    <div class="col-md-4">

        <div class="mb-2">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name"
                   class="form-control"
                   readonly />
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes"
                      class="form-control"
                      rows="1"
                      readonly></textarea>
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsActive"
                   class="form-check-input"
                   disabled />
            <label asp-for="IsActive"
                   class="form-check-label"></label>
        </div>

        <hr />

        <h4 class="mb-3">Управление</h4>

        <div class="d-flex flex-wrap gap-2 mb-4">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                <svg bootstrap-icon="Gear"
                     width="16"
                     height="16"
                     aria-hidden="true"></svg>
                Редактиране на звеното
            </a>

            <a asp-controller="Positions"
               asp-action="Index"
               asp-route-departmentId="@Model.Id"
               class="btn btn-secondary">
                <svg bootstrap-icon="Tools"
                     width="16"
                     height="16"
                     aria-hidden="true"></svg>
                Длъжности
            </a>

            <a asp-controller="Employees"
               asp-action="Index"
               asp-route-departmentId="@Model.Id"
               class="btn btn-secondary">
                <svg bootstrap-icon="PersonBadge"
                     width="16"
                     height="16"
                     aria-hidden="true"></svg>
                Служители
            </a>

        </div>

        <hr />

        <div class="mb-4">

            <h4 class="mb-3">Опасна зона</h4>

            <button type="button"
                    class="btn btn-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#deleteConfirmModal">

                <svg bootstrap-icon="Trash"
                     width="16"
                     height="16"
                     aria-hidden="true"></svg>

                Изтрий звеното
            </button>

        </div>

        <hr />

        <div class="mb-4">

            <button class="btn btn-outline-secondary"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#auditInfo"
                    aria-expanded="false"
                    aria-controls="auditInfo">

                <svg bootstrap-icon="InfoCircle"
                     width="16"
                     height="16"
                     aria-hidden="true"></svg>

                Одитна информация
            </button>

            <div class="collapse mt-3" id="auditInfo">

                <div class="card card-body">

                    <dl class="row mb-0">

                        <dt class="col-sm-4">
                            Създадено на
                        </dt>

                        <dd class="col-sm-8">
                            @(DateTimeService
                                                        .UtcToLocal(Model.CreatedAt)
                                                        .ToString("dd.MM.yyyy HH:mm"))
                        </dd>

                        <dt class="col-sm-4">
                            Последна промяна
                        </dt>

                        <dd class="col-sm-8">
                            @(Model.UpdatedAt.HasValue
                                                        ? DateTimeService
                                                        .UtcToLocal(Model.UpdatedAt.Value)
                                                        .ToString("dd.MM.yyyy HH:mm")
                                                        : "—")
                        </dd>

                        @if (Model.IsDeleted)
                        {
                            <dt class="col-sm-4">
                                Изтрито на
                            </dt>

                            <dd class="col-sm-8">
                                @(Model.DeletedAt.HasValue
                                                            ? DateTimeService
                                                            .UtcToLocal(Model.DeletedAt.Value)
                                                            .ToString("dd.MM.yyyy HH:mm")
                                                            : "—")
                        </dd>
                                                }

                    </dl>

                </div>

            </div>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <svg bootstrap-icon="ArrowLeft"
                 width="16"
                 height="16"
                 aria-hidden="true"></svg>

            Назад към звената
        </a>

    </div>
</div>

<partial name="_DeleteConfirmModal" model="deleteModal" />