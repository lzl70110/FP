@model IEnumerable<FP.Domain.Entities.Departments.Department>

@using FP.Infrastructure.Services
@inject DateTimeService DateTimeService

@{
    ViewData["Title"] = "Изтрити отдели";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Изтрити отдели</h1>

    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i>
        Назад
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Няма изтрити отдели.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Наименование</th>
                <th>Бележки</th>
                <th>Изтрито на</th>
                <th>Действия</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var department in Model)
            {
                <tr>
                    <td>
                        @department.Name
                    </td>

                    <td>
                        @department.Notes
                    </td>

                    <td>
                        @(department.DeletedAt.HasValue
                                        ? DateTimeService
                                        .UtcToLocal(department.DeletedAt.Value)
                                        .ToString("dd.MM.yyyy HH:mm")
                                        : "—")
            </td>

                    <td>
                        <form asp-action="Undelete"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@department.Id" />

                            <button type="submit"
                                    class="btn btn-success btn-sm">
                                <svg bootstrap-icon="ArrowCounterclockwise" width="16" height="16" aria-hidden="true"></svg>
                                Възстанови
                            </button>

                        </form>
                    </td>
                </tr>
                }
        </tbody>
    </table>
}