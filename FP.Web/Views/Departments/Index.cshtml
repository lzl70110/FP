
@using FP.Domain.Entities.Departments
@model List<Department>

@{
    ViewData["Title"] = "Звена";
}

<h1>Звена</h1>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        Ново звено
    </a>

    <a asp-action="Deleted" class="btn btn-secondary">
        <i class="bi bi-trash"></i>
        Изтрити звена
    </a>
</div>

<div class="list-group" style="max-width: 500px;">

    @foreach (var department in Model)
    {
        <div class="list-group-item">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="mb-1">
                        @department.Name
                    </h5>

                    @if (!string.IsNullOrWhiteSpace(department.Notes))
                    {
                        <div class="text-muted small">
                            @department.Notes
                        </div>
                    }

                    <div class="mt-1">
                        <span class="badge @(department.IsActive
                                                          ? "bg-success"
                                                          : "bg-secondary")">
                        @(department.IsActive ? "Активно" : "Неактивно")
                    </span>
                </div>
            </div>

                <div>
                    <a asp-action="Details"
                       asp-route-id="@department.Id"
                       class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Управление
                    </a>
                </div>

            </div>

        </div>
        }

</div>
 
