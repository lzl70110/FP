@using FP.Domain.Entities.Departments
@model List<Department>

@{
    ViewData["Title"] = "Отдели";
}

<h1>Отдели</h1>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        Създай отдел
    </a>

    <a asp-action="Deleted" class="btn btn-secondary">
        <i class="bi bi-trash"></i>
        Изтрити отдели
    </a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Наименование</th>
            <th>Бележки</th>
            <th>Активен</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var department in Model)
        {
            <tr>
                <td>@department.Name</td>
                <td>@department.Notes</td>
                <td>
                    @(department.IsActive ? "Да" : "Не")
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@department.Id"
                       class="btn btn-sm btn-warning">
                        Редактирай
                    </a>

                    <form asp-action="Delete"
                          asp-route-id="@department.Id"
                          method="post"
                          class="d-inline">
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-sm btn-danger">
                            Изтрий
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>