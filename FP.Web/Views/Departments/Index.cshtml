@using FP.Domain.Entities.Departments
@model List<Department>

<h1>Departments</h1>

<div class="mb-3">
    <a asp-action="Create">
        <i class="bi bi-plus-circle"></i>
        Създай отдел
    </a>
</div>

<ul>
    @foreach (var department in Model)
    {
        <li>@department.Name</li>
    }
</ul>
