
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Дневник на пожарогасителите</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/FP.web.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- Header -->
    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    🧯 Пожарогасители
                </a>

                <div class="text-center">
                    <div class="fs-5">
                        📆 Днес @DateTime.Now.ToString("dd.MM.yyyy")
                        <i>@DateTime.Now.ToString("dddd")</i>
                    </div>
                </div>

                <span class="fs-4">
                    @(User.Identity?.IsAuthenticated == true
                                        ? User.Identity.Name
                                        : "Гост")
                </span>

            </div>
        </nav>
    </header>


    <!-- Page layout -->
    <div class="container-fluid">
        <div class="row">

            <!-- Sidebar navigation -->
            <aside class="col-md-2 border-end min-vh-100 pt-3">

                <nav>
                    <ul class="nav flex-column fs-5">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Начало
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Departments"
                               asp-action="Index">
                                Отдели
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Поверителност
                            </a>
                        </li>

                    </ul>
                </nav>

            </aside>


            <!-- Main content -->
            <main role="main" class="col-md-10 pb-4 pt-3">
                @RenderBody()
            </main>

        </div>
    </div>
    <!-- CRUD result modal -->
    <partial name="_CrudResultModal" />

    <!-- Footer -->
    <footer class="border-top footer text-muted mt-auto">
        <div class="container py-3">
            © август 2026 · Дизайн и разработка: Любомир Чекански
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
 
