@using System.Globalization
@using FP.Infrastructure.Services
@inject DateTimeService DateTimeService

@{
    ViewData["Title"] ??= "FP";

 
var localNow = DateTimeService.UtcToLocal(DateTime.UtcNow);
    var bgCulture = CultureInfo.GetCultureInfo("bg-BG");
 

}

<!DOCTYPE html>

<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

 
    <title>@ViewData["Title"] - FP</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/FP.web.styles.css"
          asp-append-version="true" />
 

</head>

<body>

 
    <!-- Header -->
    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow">
            <div class="container-fluid px-3">

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    ◎ FP
                </a>

                <div class="position-absolute start-50 translate-middle-x">
                    <span class="fs-4">
                        @(User.Identity?.IsAuthenticated == true
                                                ? User.Identity.Name
                                                : "Гост")
                    </span>
                </div>

                <div class="ms-auto text-end me-2">
                    <div class="fs-5">
                        📆 @localNow.ToString("dd.MM.yyyy")
                        · <i>@localNow.ToString("dddd", bgCulture)</i>
                        · <span id="live-clock"
                                data-timezone="Europe/Sofia">
                            @localNow.ToString("HH:mm:ss")
                        </span>
                    </div>
                </div>

            </div>
        </nav>
    </header>


    <!-- Page layout -->
    <div class="container-fluid">
        <div class="row">

            <!-- Sidebar navigation -->
            <aside class="col-md-2 border-end min-vh-100 pt-3">

                <partial name="~/Views/Shared/_MainMenu.cshtml" />

                <partial name="~/Views/Shared/_AdminMenu.cshtml" />

            </aside>


            <!-- Main content -->
            <main role="main" class="col-md-10 pb-4 pt-3">
                @RenderBody()
            </main>

        </div>
    </div>


    <!-- CRUD result modal -->
    <partial name="_CrudResultModal" />


    <!-- Footer -->
    <footer class="border-top footer text-muted mt-auto">
        <div class="container py-3">
            © @localNow.Year · Дизайн и разработка: Любомир Чекански
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
   

</body>
</html>
